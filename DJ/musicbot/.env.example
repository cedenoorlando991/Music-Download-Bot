# Copy this file to ".env" (same folder) and fill in your real values.
# ".env" is gitignored so your token never gets committed.

# From @BotFather (no quotes, no spaces):
TELEGRAM_BOT_TOKEN=123456789:PASTE_YOUR_BOTFATHER_TOKEN_HERE

# Your numeric Telegram user ID(s), comma-separated (send /id to the bot):
ALLOWED_USER_IDS=111111111

# Absolute paths inside the repo checkout (replace YOURNAME):
MUSIC_DL=/Users/YOURNAME/Music-Download-Bot/DJ/music-dl
MUSIC_DIR=/Users/YOURNAME/Music-Download-Bot/DJ/Music

# Path to spotdl in your venv (Spotify support). Leave as-is if you used the
# recommended venv location:
SPOTDL=/Users/YOURNAME/Music-Download-Bot/DJ/musicbot/venv/bin/spotdl
